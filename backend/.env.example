# SmartQueue Kosova — Environment Template
# Kopjo si backend/.env dhe plotëso vlerat. MOS e commit .env.

PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/smartqueue_kosova
JWT_SECRET=change_me_to_a_long_random_string
CLIENT_URL=http://localhost:5178

# Email (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartQueue Kosova <noreply@smartqueue.ks>

# Twilio (opsional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# SMS multi-provider (falas së pari)
# textbee = SMS reale falas me telefon Android (textbee.dev)
SMS_PROVIDER_ORDER=textbee,textbelt,gateway,infobip,vonage,twilio

# TextBee — https://textbee.dev (falas: ~50 SMS/ditë me telefonin tënd)
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

TEXTBELT_KEY=textbelt
# SMS_GATEWAY_URL=
# SMS_GATEWAY_TOKEN=

INFOBIP_API_KEY=
INFOBIP_BASE_URL=https://api.infobip.com
INFOBIP_SENDER=SmartQueue
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=SmartQueue

# Telegram (kanali kryesor falas)
TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=https://api.yourdomain.com
TELEGRAM_WEBHOOK_SECRET=

# Viber Bot — https://partners.viber.com
VIBER_AUTH_TOKEN=
VIBER_BOT_URI=
VIBER_SENDER_NAME=SmartQueue Kosova
# VIBER_WEBHOOK_URL=https://xxxx.ngrok-free.app

# WhatsApp Cloud API (iOS + Android) — https://developers.facebook.com
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=383XXXXXXXX
WHATSAPP_VERIFY_TOKEN=smartqueue_wa_verify
# WHATSAPP_API_VERSION=v21.0
# Webhook URL (Meta): https://your-domain/api/whatsapp/webhook

# xAI Grok (opsional)
XAI_API_KEY=
GROK_MODEL=grok-4.5

# Frontend (.env në root)
# VITE_API_URL=http://localhost:5001/api
# VITE_SOCKET_URL=http://localhost:5001
